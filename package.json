{
    "name": "@fantasticfugue/fughetta-cli",
    "version": "0.1.0",
    "description": "Fughetta command line client and checkout MCP server",
    "license": "MPL-2.0",
    "bin": {
        "fug": "build/cli.js"
    },
    "files": [
        "build/**/*.js",
        "build/**/*.d.ts",
        "LICENSE",
        "README.md"
    ],
    "type": "module",
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "test": "node --test --test-concurrency=1 tests/*.test.mjs",
        "format": "oxfmt .",
        "format:check": "oxfmt --check ."
    },
    "dependencies": {
        "ignore": "^7.0.14"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "oxfmt": "^0.72.0",
        "typescript": "^7.0.2"
    },
    "engines": {
        "node": ">=22"
    },
    "packageManager": "bun@1.4.4"
}
